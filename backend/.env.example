# Server
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Database (local dev). Works with both local MongoDB and Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/hopfastbridge

# LI.FI swap API key; public-tier access may work for development.
LIFI_API_KEY=
LIFI_API_BASE_URL=https://li.quest/v1
LIFI_SLIPPAGE=0.005

# Squid Router API
SQUID_API_BASE_URL=https://v2.api.squidrouter.com
SQUID_INTEGRATOR_ID=

# Relay: server-only key from dashboard.relay.link. Required in production.
RELAY_API_KEY=
RELAY_FEE_RECIPIENT=0xe7953857d0dBA2d39B6Fb8e63296e408058120F4
RELAY_SLIPPAGE_BPS=50

# Arc payments: use a persistent disk for this single-process local store.
ARC_RPC_URL=https://rpc.mainnet.arc.io
APP_BASE_URL=http://localhost:5173
PAYMENT_STORE_PATH=./data/payments.json
# Optional server-only RPC overrides for verified swap history, keyed by chain.
# No Alchemy browser key is used for these checks.
SWAP_RPC_URLS={}
# Optional dedicated 32-byte hex secret. By default, domain-separated existing
# server signer material is used, or a private key file beside PAYMENT_STORE_PATH.
# HISTORY_SIGNING_SECRET=
# Persistent-store creation safeguards. Existing records are never auto-pruned.
PAYMENT_MAX_RECORDS=10000
PAYMENT_MAX_STORE_BYTES=8388608
PAYMENT_MAX_ACTIVE=500
PAYMENT_MAX_ACTIVE_PER_WALLET=20
PAYMENT_CREATION_PER_MINUTE=60
PAYMENT_CREATION_PER_HOUR=300
COINGECKO_API_KEY=
CMC_API_KEY=

# Optional LI.FI monetization: configure the integrator and wallet in the portal first.
LIFI_INTEGRATOR=
LIFI_FEE=0.0005

# Private X username payments: server-only escrow and X credentials.
ARCHITECT_CHAIN_ID=5042
ARCHITECT_ESCROW_ADDRESS=
ARCHITECT_SIGNER_KEY=
ARCHITECT_ADMIN_ADDRESS=
ARCHITECT_TREASURY_ADDRESS=
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://127.0.0.1:8080/api/architects/x/callback

# Invoice checkout is separate from X username escrow. Keep it disabled until deployed and verified.
INVOICE_ESCROW_ADDRESS=
INVOICE_SIGNER_KEY=
# Omit these to use the configured project owner wallet for both roles.
# INVOICE_ADMIN_ADDRESS=0x...
# INVOICE_TREASURY_ADDRESS=0x...
