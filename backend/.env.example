# Server
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Database (local dev). Works with both local MongoDB and Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/hopfastbridge

# LI.FI swap API key; public-tier access may work for development.
LIFI_API_KEY=
LIFI_API_BASE_URL=https://li.quest/v1
LIFI_SLIPPAGE=0.005

# Squid Router API
SQUID_API_BASE_URL=https://v2.api.squidrouter.com
SQUID_INTEGRATOR_ID=

# Arc payments: use a persistent disk for this single-process local store.
ARC_RPC_URL=https://rpc.mainnet.arc.io
APP_BASE_URL=http://localhost:5173
PAYMENT_STORE_PATH=./data/payments.json
COINGECKO_API_KEY=
CMC_API_KEY=

# Optional LI.FI monetization: configure the integrator and wallet in the portal first.
LIFI_INTEGRATOR=
LIFI_FEE=0.0005

# Support Architects: server-only escrow and X credentials.
ARCHITECT_CHAIN_ID=5042
ARCHITECT_ESCROW_ADDRESS=
ARCHITECT_SIGNER_KEY=
ARCHITECT_ADMIN_ADDRESS=0xe7953857d0dBA2d39B6Fb8e63296e408058120F4
ARCHITECT_TREASURY_ADDRESS=0xe7953857d0dBA2d39B6Fb8e63296e408058120F4
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://127.0.0.1:8080/api/architects/x/callback
