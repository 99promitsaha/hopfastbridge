# Server
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Database (local dev). Works with both local MongoDB and Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/hopfast

# LI.FI API — required. Sign up at https://li.quest for a key.
LIFI_API_KEY=
LIFI_API_BASE_URL=https://li.quest/v1
LIFI_SLIPPAGE=0.005

# Squid Router API
SQUID_API_BASE_URL=https://v2.api.squidrouter.com
SQUID_INTEGRATOR_ID=
