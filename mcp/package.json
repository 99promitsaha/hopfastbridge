{
  "name": "@hopfast/mcp",
  "version": "0.1.0",
  "description": "Hopfastbridge MCP tools for swap routing and user-approved Arc payments",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hopfast-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "npm run build && node tests/workflows.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "defi",
    "crypto",
    "cross-chain",
    "swap",
    "hopfast",
    "arc",
    "payments"
  ]
}
