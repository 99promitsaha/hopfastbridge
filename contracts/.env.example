# Start with Arc testnet. Deployment spends gas and requires explicit review.
ARC_RPC_URL=https://rpc.testnet.arc.io
ARCHITECT_ADMIN_ADDRESS=
ARCHITECT_TREASURY_ADDRESS=
ARCHITECT_SIGNER_ADDRESS=
DEPLOYER_PRIVATE_KEY=
# Only set after reviewing the exact deployment.
CONFIRM_DEPLOY=

# Separate invoice escrow deployment. Owner and treasury default to the project owner wallet.
INVOICE_SIGNER_ADDRESS=
# INVOICE_ADMIN_ADDRESS=0x...
# INVOICE_TREASURY_ADDRESS=0x...
# Invoice deployment confirmation is invoice-arc-<chainId>.
